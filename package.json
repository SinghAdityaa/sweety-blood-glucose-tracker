{
  "name": "sweety-blood-glucose-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A personal blood glucose tracker built with React, Express and PostgreSQL.",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=20.14.0" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server test",
    "migrate": "npm --workspace server run migrate",
    "seed": "npm --workspace server run seed"
  }
}
