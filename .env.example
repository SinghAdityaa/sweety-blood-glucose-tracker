# For a no-install local run, use embedded PostgreSQL:
# DATABASE_URL=pglite://./.data/sweety
# For Docker or a local PostgreSQL server, use a postgres:// URL.
POSTGRES_PASSWORD=sweety_dev_password
DATABASE_URL=pglite://./.data/sweety

# Replace this value before exposing the app outside your computer.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=sweety_session
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
API_PORT=4000
NODE_ENV=development

# Demo account created by `npm run seed`
DEMO_USER_NAME=Sweety Demo
DEMO_USER_EMAIL=demo@sweety.local
DEMO_USER_PASSWORD=SweetyDemo123!
